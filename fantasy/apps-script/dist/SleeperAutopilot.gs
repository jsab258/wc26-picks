 var(--radius);\n    box-shadow: var(--shadow); padding: 16px; margin-bottom: 14px; }\n  h2 { font-size: 17px; margin: 0; letter-spacing: -.01em; }\n  h3 { font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); margin: 18px 0 8px; }\n  .row { display: flex; align-items: center; gap: 10px; }\n  .between { justify-content: space-between; }\n  .wrapflex { flex-wrap: wrap; }\n  a { color: var(--accent); }\n  .muted { color: var(--muted); } .faint { color: var(--faint); } .small { font-size: 13px; }\n  .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }\n  .chip { font-size: 12px; padding: 3px 8px; border-radius: 999px; background: var(--surface-2); color: var(--muted);\n    border: 1px solid var(--border); white-space: nowrap; }\n  .chip.accent { background: var(--accent-soft); color: var(--accent); border-color: transparent; font-weight: 600; }\n  button { font: inherit; cursor: pointer; border-radius: 10px; border: 1px solid var(--border);\n    background: var(--surface); color: var(--text); padding: 9px 14px; font-weight: 600; }\n  button.primary { background: var(--accent); color: var(--accent-ink); border-color: transparent; }\n  button.ghost { background: transparent; border-color: transparent; color: var(--muted); padding: 6px 8px; }\n  button:disabled { opacity: .55; cursor: default; }\n  button.small { padding: 6px 10px; font-size: 13px; }\n  input[type=text], input[type=password], input[type=email], input[type=number], textarea {\n    font: inherit; width: 100%; padding: 11px 12px; border-radius: 10px; border: 1px solid var(--border);\n    background: var(--surface); color: var(--text); }\n  input:focus, textarea:focus, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\n  label.field { display: block; margin: 12px 0 0; font-size: 13px; color: var(--muted); }\n  label.field span { display: block; margin-bottom: 5px; }\n\n  /* status hero */\n  .hero { display: grid; gap: 12px; }\n  .status-dot { width: 10px; height: 10px; border-radius: 50%; background: var(--faint); flex: none; }\n  .status-dot.on { background: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }\n  .status-dot.off { background: var(--warn); box-shadow: 0 0 0 4px var(--warn-soft); }\n  .hero-title { font-size: 19px; font-weight: 700; }\n  .switch { position: relative; width: 50px; height: 30px; flex: none; }\n  .switch input { opacity: 0; width: 0; height: 0; }\n  .slider { position: absolute; inset: 0; border-radius: 999px; background: var(--border); transition: .15s; cursor: pointer; }\n  .slider:before { content: \"\"; position: absolute; width: 24px; height: 24px; left: 3px; top: 3px; border-radius: 50%;\n    background: #fff; transition: .15s; box-shadow: 0 1px 3px rgba(0,0,0,.25); }\n  .switch input:checked + .slider { background: var(--accent); }\n  .switch input:checked + .slider:before { transform: translateX(20px); }\n  .switch.sm { width: 40px; height: 24px; }\n  .switch.sm .slider:before { width: 18px; height: 18px; }\n  .switch.sm input:checked + .slider:before { transform: translateX(16px); }\n  .facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 8px; }\n  .fact { background: var(--surface-2); border-radius: 10px; padding: 10px 12px; }\n  .fact b { display: block; font-size: 12px; color: var(--muted); font-weight: 600; margin-bottom: 2px; }\n\n  /* lineup */\n  .slots { display: grid; gap: 6px; }\n  .slot { display: grid; grid-template-columns: 74px 1fr auto; align-items: center; gap: 10px;\n    padding: 8px 10px; border-radius: 10px; background: var(--surface-2); border: 1px solid transparent; }\n  .slot.new { border-color: var(--accent); background: var(--accent-soft); }\n  .slot.bad { border-color: var(--bad); background: var(--bad-soft); }\n  .slot-tag { font-size: 11px; font-weight: 700; letter-spacing: .03em; color: var(--muted); text-transform: uppercase; }\n  .pname { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .pmeta { font-size: 12px; color: var(--muted); }\n  .rank { font-size: 12px; color: var(--muted); text-align: right; white-space: nowrap; }\n  .tag { display: inline-block; font-size: 11px; font-weight: 700; padding: 1px 6px; border-radius: 6px; margin-left: 6px;\n    vertical-align: 1px; }\n  .tag.in { background: var(--accent); color: var(--accent-ink); }\n  .tag.out { background: var(--bad-soft); color: var(--bad); }\n  .tag.lock { background: var(--surface); color: var(--faint); border: 1px solid var(--border); }\n  .banner { border-radius: 10px; padding: 10px 12px; font-size: 14px; margin: 8px 0; }\n  .banner.ok { background: var(--accent-soft); color: var(--accent); }\n  .banner.warn { background: var(--warn-soft); color: var(--warn); }\n  .banner.bad { background: var(--bad-soft); color: var(--bad); }\n  .banner.info { background: var(--info-soft); color: var(--info); }\n  .claim { display: grid; grid-template-columns: 1fr auto; gap: 8px; align-items: center; padding: 10px 12px;\n    border-radius: 10px; background: var(--surface-2); margin-bottom: 6px; }\n  .claim .arrow { color: var(--faint); margin: 0 4px; }\n  .add { color: var(--accent); font-weight: 600; } .drop { color: var(--bad); }\n  details summary { cursor: pointer; color: var(--muted); font-size: 13px; margin-top: 10px; list-style: none; }\n  details summary::-webkit-details-marker { display: none; }\n  details summary:before { content: \"▸ \"; }\n  details[open] summary:before { content: \"▾ \"; }\n  .settings-grid { display: grid; gap: 10px; margin-top: 10px; }\n  .setting { display: flex; align-items: center; justify-content: space-between; gap: 12px; }\n  .setting .label { font-size: 14px; }\n  .setting .hint { font-size: 12px; color: var(--muted); }\n  input[type=range] { width: 140px; accent-color: var(--accent); }\n  input.num { width: 70px; padding: 6px 8px; }\n\n  /* activity */\n  .feed { display: grid; gap: 2px; }\n  .entry { display: grid; grid-template-columns: 26px 1fr; gap: 10px; padding: 10px 2px; border-bottom: 1px solid var(--border); }\n  .entry:last-child { border-bottom: 0; }\n  .ico { width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; font-size: 13px;\n    background: var(--surface-2); }\n  .ico.change { background: var(--accent-soft); color: var(--accent); }\n  .ico.error { background: var(--bad-soft); color: var(--bad); }\n  .entry pre { margin: 4px 0 0; font: 12px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace; color: var(--muted);\n    white-space: pre-wrap; }\n\n  /* login */\n  .center { min-height: 80vh; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n  .center > .card { width: 100%; max-width: 400px; }\n  .login { width: 100%; max-width: 400px; }\n  .login h1 { font-size: 22px; margin: 14px 0 4px; letter-spacing: -.02em; }\n  .code { letter-spacing: .5em; text-align: center; font-size: 22px; font-weight: 700; }\n  .fine { font-size: 12px; color: var(--muted); margin-top: 14px; }\n  .err { color: var(--bad); font-size: 13px; margin-top: 10px; min-height: 1em; }\n\n  /* misc */\n  .skeleton { height: 14px; border-radius: 6px; background: linear-gradient(90deg, var(--surface-2), var(--border), var(--surface-2));\n    background-size: 200% 100%; animation: sh 1.2s infinite; margin: 8px 0; }\n  @keyframes sh { from { background-position: 200% 0; } to { background-position: -200% 0; } }\n  .spin { display: inline-block; width: 14px; height: 14px; border: 2px solid currentColor; border-right-color: transparent;\n    border-radius: 50%; animation: rot .7s linear infinite; vertical-align: -2px; margin-right: 6px; }\n  @keyframes rot { to { transform: rotate(360deg); } }\n  .toast { position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%); background: var(--text); color: var(--bg);\n    padding: 10px 14px; border-radius: 10px; font-size: 14px; box-shadow: var(--shadow); max-width: calc(100% - 32px);\n    opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 10; }\n  .toast.show { opacity: 1; }\n  @media (max-width: 480px) {\n    .slot { grid-template-columns: 58px 1fr auto; }\n    .wrap { padding: 12px 12px 40px; }\n  }\n</style>\n</head>\n<body>\n<div class=\"wrap\" id=\"app\"><div class=\"center\"><span class=\"muted\"><span class=\"spin\"></span>Loading…</span></div></div>\n<div class=\"toast\" id=\"toast\"></div>\n<script>\n// Sleeper puts a captcha in front of password logins from other sites, so connecting\n// via sleeper.com is the default; the password form stays as a fallback.\nconst freshLogin = (extra) => Object.assign({ step: 'token', desktop: matchMedia('(pointer: fine)').matches }, extra);\nconst S = { state: null, dash: null, loadingDash: false, busy: {}, login: freshLogin(), dashError: null,\n            update: {} };\n\n// ---- server calls ------------------------------------------------------\n// Every server call goes through call(name, args): an installed update can then add\n// server functions that the pasted code doesn't declare.\nfunction api(fn, ...args) {\n  return new Promise((resolve, reject) => {\n    google.script.run.withSuccessHandler(resolve)\n      .withFailureHandler((e) => reject(new Error(((e && e.message) || String(e)).replace(/^(Error:\\s*)+/, ''))))\n      .call(fn, args);\n  });\n}\n\n// ---- Sleeper login from this browser ------------------------------------\n// Logging in from your own browser looks like a normal login to Sleeper;\n// the same request from Google's servers gets a \"confirm you're human\" wall.\n// URLs are written with \\/\\/ on purpose: when Google serves this page it cuts off\n// everything after \"//\" inside `template` text, as if it were a comment.\nconst SLEEPER_GQL = 'https:\\/\\/api.sleeper.app/graphql';\nconst SLEEPER_LOGIN_URL = 'https:\\/\\/sleeper.com/login';\nconst AVATAR_URL = 'https:\\/\\/sleepercdn.com/avatars/thumbs/';\nconst Q_LOGIN = 'query login($e: String!, $p: String!, $c: String) {' +\n  ' login(email_or_phone_or_username: $e, password: $p, captcha: $c) { token } }';\nconst Q_CONTEXT = 'query login_context_by_email_or_phone_or_username($e: String!) {' +\n  ' login_context_by_email_or_phone_or_username(email_or_phone_or_username: $e) }';\nconst M_SEND_CODE = 'mutation create_verification_code($e: String!, $c: String) {' +\n  ' create_verification_code(email_or_phone: $e, captcha: $c) }';\nconst CAPTCHA_MSG = 'Sleeper wants a captcha before it lets this login through. That usually clears if you ' +\n  'leave it alone for an hour; or connect via sleeper.com now.';\n\nclass Blocked extends Error {}\n\nasync function sleeperGql(query, variables) {\n  let r;\n  try {\n    r = await fetch(SLEEPER_GQL, { method: 'POST', headers: { 'Content-Type': 'application/json' },\n                                   body: JSON.stringify({ query, variables }) });\n  } catch (e) {\n    throw new Blocked(e.message);  // the browser wouldn't let us call Sleeper directly\n  }\n  const body = await r.json().catch(() => ({}));\n  if (body.errors && body.errors.length) {\n    const err = new Error(body.errors.map((x) => x.message).join('; '));\n    err.codes = body.errors.map((x) => x.code || (x.extensions && x.extensions.code) || '');\n    throw err;\n  }\n  return body.data || {};\n}\n\nasync function sleeperContext(identifier) {\n  try {\n    return (await sleeperGql(Q_CONTEXT, { e: identifier })).login_context_by_email_or_phone_or_username || {};\n  } catch (e) { return {}; }\n}\n\n/** Returns {token, userId} | {needsCode, sentTo}; throws Blocked if fetch is impossible. */\nasync function browserLogin(identifier, secret) {\n  let data;\n  try {\n    data = await sleeperGql(Q_LOGIN, { e: identifier, p: secret });\n  } catch (e) {\n    if (e instanceof Blocked) throw e;\n    if ((e.codes || []).includes('code_verification_required')) {\n      await sleeperGql(M_SEND_CODE, { e: identifier });\n      const ctx = await sleeperContext(identifier);\n      return { needsCode: true, sentTo: ctx.masked_email || ctx.masked_phone || 'your email' };\n    }\n    if (/human|captcha/i.test(e.message)) throw new Error(CAPTCHA_MSG);\n    throw new Error('Sleeper refused the login: ' + e.message);\n  }\n  if (!data.login || !data.login.token) {\n    throw new Error(/^\\d{4}$/.test(secret) ? \"That code didn't work. Check the latest email from Sleeper.\"\n                                           : \"Sleeper didn't accept that email/username and password.\");\n  }\n  const ctx = await sleeperContext(identifier);\n  return { token: data.login.token, userId: ctx.user_id || null };\n}\n\n// ---- helpers -----------------------------------------------------------\nconst esc = (s) => String(s == null ? '' : s).replace(/[&<>\"']/g, (c) =>\n  ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst $ = (sel) => document.querySelector(sel);\n\nfunction ago(ts) {\n  if (!ts) return 'never';\n  const s = Math.round((Date.now() - ts) / 1000);\n  if (s < 60) return 'just now';\n  if (s < 3600) return Math.round(s / 60) + ' min ago';\n  if (s < 86400) return Math.round(s / 3600) + ' h ago';\n  return new Date(ts).toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric' });\n}\nconst when = (ts) => new Date(ts).toLocaleString([], { weekday: 'short', hour: '2-digit', minute: '2-digit' });\n\nfunction toast(msg) {\n  const t = $('#toast');\n  t.textContent = msg;\n  t.classList.add('show');\n  clearTimeout(toast._t);\n  toast._t = setTimeout(() => t.classList.remove('show'), 3500);\n}\n\nasync function busy(key, fn) {\n  S.busy[key] = true; render();\n  try { return await fn(); }\n  catch (e) { if (!expired(e)) toast(e.message); throw e; }\n  finally { S.busy[key] = false; render(); }\n}\n\n/** Sleeper rejected the saved session: the server dropped it, so show the login again. */\nfunction expired(e) {\n  if (!/session expired/i.test(e.message)) return false;\n  S.dash = null;\n  S.login = freshLogin({ error: e.message });\n  api('getState').then((st) => { S.state = st; render(); });\n  return true;\n}\n\n// ---- data flow ---------------------------------------------------------\nasync function boot() {\n  try { S.state = await api('getState'); }\n  catch (e) { $('#app').innerHTML = `<div class=\"card banner bad\">${esc(e.message)}</div>`; return; }\n  render();\n  if (S.state.connected) loadDashboard();\n  checkUpdate();\n}\n\nasync function checkUpdate() {\n  try { S.update = { result: await api('checkForUpdate') }; } catch (e) { S.update = {}; }\n  render();\n}\n\nasync function installUpdate() {\n  S.update.error = null;\n  try {\n    const r = await busy('update', () => api('installUpdate', S.update.result.latest.id));\n    S.update.installed = r;\n  } catch (e) { S.update.error = e.message; }\n  render();\n}\n\nconst linkify = (t) => esc(t).replace(/https:\\/\\/[^\\s,)]+/g, (u) => `<a href=\"${u}\" target=\"_blank\">${u}</a>`);\n\nfunction updateBanner() {\n  const U = S.update;\n  const st = S.state || {};\n  if (st.update && st.update.error) {\n    return `<div class=\"card banner bad\"><b>The installed update couldn't load</b>\n      <div class=\"small\" style=\"margin-top:6px\">${esc(st.update.error)}. The app is running the version you pasted.</div>\n      <div style=\"margin-top:8px\"><button class=\"small\" data-action=\"remove-update\">Remove the update</button></div></div>`;\n  }\n  if (U.installed) {\n    const url = U.installed.url;\n    return `<div class=\"card banner ok\">✓ Update “${esc(U.installed.info.title)}” installed.\n      ${url ? `<a href=\"${esc(url)}\" target=\"_top\"><b>Reload the app</b></a>` : 'Reload this page'} to use it.</div>`;\n  }\n  const r = U.result;\n  if (!r || !r.available) return '';\n  const notes = (r.notes || []).map((n) => `<div style=\"margin-top:6px\"><b>${esc(n.title)}</b>\n      <ul style=\"margin:4px 0 0;padding-left:18px\">${n.items.map((i) => `<li>${esc(i)}</li>`).join('')}</ul></div>`).join('');\n  return `<div class=\"card banner info\">\n    <div class=\"row between wrapflex\"><b>Update available</b>\n      <button class=\"small primary\" data-action=\"install-update\" ${S.busy.update ? 'disabled' : ''}>\n        ${S.busy.update ? '<span class=\"spin\"></span>Installing…' : 'Install update'}</button></div>\n    <div class=\"small\">${notes}</div>\n    ${U.error ? `<div class=\"small\" style=\"color:var(--bad);margin-top:8px\">${linkify(U.error)}</div>` : ''}\n  </div>`;\n}\n\nasync function loadDashboard() {\n  S.loadingDash = true; S.dashError = null; render();\n  try {\n    S.dash = await api('getDashboard');\n    S.state = S.dash.state;\n  } catch (e) { if (!expired(e)) S.dashError = e.message; }\n  S.loadingDash = false; render();\n}\n\nfunction replaceLeague(res) {\n  if (!S.dash) return;\n  const i = S.dash.leagues.findIndex((l) => l.id === res.id);\n  if (i >= 0) {\n    const old = S.dash.leagues[i];\n    S.dash.leagues[i] = Object.assign({}, old, res, {\n      lineup: res.lineup || old.lineup, waivers: res.waivers || old.waivers });\n  }\n}\n\n// ---- rendering ---------------------------------------------------------\nfunction render() {\n  const st = S.state;\n  if (!st) return;\n  $('#app').innerHTML = st.connected ? appView(st)\n    : loginView().replace('<div class=\"center\">', '<div class=\"center\">' + permissionBanner(st) + updateBanner());\n  const first = document.querySelector('[autofocus]');\n  if (first && !render._focused) { first.focus(); render._focused = true; }\n}\n\nfunction loginView() {\n  const L = S.login;\n  const header = `<div class=\"logo\">⚡</div><h1>Sleeper Autopilot</h1>\n    <div class=\"muted\">Sets your lineups and waiver claims from FantasyPros expert rankings, following each league's rules.</div>`;\n  if (L.step === 'code') {\n    return `<div class=\"center\"><div class=\"card login\">${header}\n      <form data-form=\"code\">\n        <label class=\"field\"><span>Sleeper emailed a 4-digit code to ${esc(L.sentTo)}</span>\n          <input class=\"code\" name=\"code\" inputmode=\"numeric\" maxlength=\"4\" autocomplete=\"one-time-code\" autofocus required></label>\n        <div class=\"err\">${esc(L.error || '')}</div>\n        <button class=\"primary\" style=\"width:100%;margin-top:6px\" ${S.busy.login ? 'disabled' : ''}>\n          ${S.busy.login ? '<span class=\"spin\"></span>Checking…' : 'Verify'}</button>\n      </form>\n      <button class=\"ghost small\" data-action=\"login-restart\" style=\"margin-top:8px\">← Start over</button>\n    </div></div>`;\n  }\n  if (L.step === 'token') {\n    return `<div class=\"center\"><div class=\"card login\">${header}\n      <div class=\"small muted\" style=\"margin-top:14px\"><b>Connect your Sleeper account.</b> Sleeper only lets its own\n        site log you in (it shows a captcha), so log in there and copy your session over. You only do this once.</div>\n      <details ${L.desktop ? '' : 'open'}><summary>On your phone (Chrome)</summary>\n        <ol class=\"small muted\" style=\"padding-left:18px;margin:8px 0 0\">\n          <li>Copy this helper: <button type=\"button\" class=\"small\" data-action=\"copy-helper\">Copy helper</button>\n            <textarea id=\"helper\" readonly rows=\"2\" class=\"small\" style=\"margin-top:6px;font-family:ui-monospace,Menlo,monospace\">${esc(BOOKMARKLET)}</textarea></li>\n          <li>Bookmark any page (⋮ → ☆), tap <b>Edit</b>, set the name to <b>sleeper login</b> and replace the URL with\n            the helper.</li>\n          <li>Open <a href=\"${SLEEPER_LOGIN_URL}\" target=\"_blank\">sleeper.com/login</a> and log in.</li>\n          <li>There, tap the address bar, type <b>sleeper login</b> and tap the ★ bookmark suggestion. It copies your\n            session (if it shows a box instead, copy the text in it).</li>\n          <li>Come back here and paste it below.</li>\n        </ol></details>\n      <details ${L.desktop ? 'open' : ''}><summary>On a computer</summary>\n        <ol class=\"small muted\" style=\"padding-left:18px;margin:8px 0 0\">\n          <li>Log in at <a href=\"${SLEEPER_LOGIN_URL}\" target=\"_blank\">sleeper.com</a>.</li>\n          <li>Press <b>F12</b>, open <b>Console</b> and paste this line, then Enter. If Chrome asks, type\n            <b>allow pasting</b> first.\n            <textarea readonly rows=\"2\" class=\"small\" style=\"margin-top:6px;font-family:ui-monospace,Menlo,monospace\">${esc(CONSOLE_LINE)}</textarea></li>\n          <li>Paste the result below.</li>\n        </ol></details>\n      <form data-form=\"token\">\n        <label class=\"field\"><span>Paste your Sleeper session</span><textarea name=\"token\" rows=\"3\" required></textarea></label>\n        <div class=\"err\">${esc(L.error || '')}</div>\n        <button class=\"primary\" style=\"width:100%;margin-top:6px\" ${S.busy.login ? 'disabled' : ''}>\n          ${S.busy.login ? '<span class=\"spin\"></span>Connecting…' : 'Connect'}</button>\n      </form>\n      <button class=\"ghost small\" data-action=\"login-restart\" style=\"margin-top:8px\">Log in with password instead</button>\n    </div></div>`;\n  }\n  return `<div class=\"center\"><div class=\"card login\">${header}\n    <form data-form=\"login\" autocomplete=\"on\">\n      <label class=\"field\"><span>Sleeper email or username</span>\n        <input type=\"text\" name=\"identifier\" autocomplete=\"username\" value=\"${esc(L.identifier || '')}\"\n          ${L.identifier ? '' : 'autofocus'} required></label>\n      <label class=\"field\"><span>Password</span>\n        <input type=\"password\" name=\"password\" autocomplete=\"current-password\" ${L.identifier ? 'autofocus' : ''} required></label>\n      <div class=\"err\">${esc(L.error || '')}</div>\n      ${/captcha/i.test(L.error || '') ? `<button type=\"button\" class=\"small\" data-action=\"login-token\"\n          style=\"width:100%;margin-bottom:8px\">Connect via sleeper.com</button>` : ''}\n      <button class=\"primary\" style=\"width:100%;margin-top:6px\" ${S.busy.login ? 'disabled' : ''}>\n        ${S.busy.login ? '<span class=\"spin\"></span>Logging in…' : 'Log in with Sleeper'}</button>\n    </form>\n    <div class=\"fine\">Your password is only used to log in to Sleeper and is never saved. This page and your Sleeper\n      session live in your own Google account; nobody else can open it.</div>\n    <button class=\"ghost small\" data-action=\"login-token\" style=\"margin-top:6px\">← Connect via sleeper.com</button>\n  </div></div>`;\n}\n\nfunction appView(st) {\n  const u = st.user || {};\n  const avatar = u.avatar ? `<img class=\"avatar\" src=\"${AVATAR_URL}${esc(u.avatar)}\" alt=\"\">` : '';\n  return `<header>\n      <div class=\"brand\"><div class=\"logo\">⚡</div>Sleeper Autopilot</div>\n      <div class=\"who\">${avatar}<span>${esc(u.display_name || '')}</span>\n        <button class=\"ghost small\" data-action=\"logout\" title=\"Disconnect\">Log out</button></div>\n    </header>\n    ${permissionBanner(st)}\n    ${updateBanner()}\n    ${statusCard(st)}\n    ${S.dashError ? `<div class=\"card banner bad\">Couldn't load your leagues: ${esc(S.dashError)}\n        <div style=\"margin-top:8px\"><button class=\"small\" data-action=\"reload\">Try again</button></div></div>` : ''}\n    ${S.loadingDash && !S.dash ? skeletonCards() : ''}\n    ${S.dash ? S.dash.leagues.map(leagueCard).join('') : ''}\n    ${activityCard(st.log || [])}\n    <div class=\"faint small\" style=\"text-align:center;margin-top:18px\">\n      Rankings: FantasyPros ECR · Data: Sleeper · Refreshed ${S.dash ? 'week ' + esc(S.dash.week) : '…'}\n      · <a href=\"#\" data-action=\"reload\" style=\"color:inherit\">refresh</a>\n      <br>Version: ${esc((st.build || {}).title || '?')} · ${esc((st.build || {}).id || '')}\n      ${st.update && st.update.installed ? ' (installed update)' : ''}</div>`;\n}\n\nfunction permissionBanner(st) {\n  const p = st.permissions;\n  if (!p) return '';\n  return `<div class=\"card banner bad\"><b>Google permission missing</b>\n    <div class=\"small\" style=\"margin-top:6px\">The app can't reach Sleeper or run in the background until you approve\n      every permission (tick “Select all” on Google's screen), then reload this page.</div>\n    <div style=\"margin-top:8px\"><a class=\"chip accent\" href=\"${esc(p.url)}\" target=\"_blank\">Approve in Google</a></div>\n  </div>`;\n}\n\nfunction statusCard(st) {\n  const on = st.mode === 'auto';\n  const t = st.lastTick;\n  const tickTxt = t ? `${esc(t.msg)} <span class=\"faint\">(${ago(t.ts)})</span>` : 'Not run yet';\n  const exp = st.tokenExpires ? when(st.tokenExpires * 1000) : 'not stated by Sleeper';\n  const expSoon = st.tokenExpires && st.tokenExpires * 1000 - Date.now() < 7 * 86400000;\n  return `<div class=\"card hero\">\n    <div class=\"row between\">\n      <div class=\"row\"><span class=\"status-dot ${on ? 'on' : 'off'}\"></span>\n        <div><div class=\"hero-title\">${on ? 'Autopilot is on' : 'Suggestions only'}</div>\n          <div class=\"muted small\">${on ? 'Changes your lineups (and claims where enabled) automatically.'\n                                         : 'Nothing is changed on Sleeper until you turn autopilot on or tap Apply.'}</div></div></div>\n      <label class=\"switch\" title=\"Autopilot\"><input type=\"checkbox\" data-action=\"mode\" ${on ? 'checked' : ''}\n        ${S.busy.mode ? 'disabled' : ''}><span class=\"slider\"></span></label>\n    </div>\n    <div class=\"facts\">\n      <div class=\"fact\"><b>Last check</b>${t && t.status === 'error' ? `<span style=\"color:var(--bad)\">${tickTxt}</span>` : tickTxt}</div>\n      <div class=\"fact\"><b>Schedule</b>Every 30 min: lineups before games, claims the evening before waivers.</div>\n      <div class=\"fact\"><b>Sleeper session</b>${expSoon ? '<span style=\"color:var(--warn)\">Expires ' + exp + '</span>' : 'Valid · expires ' + exp}</div>\n    </div>\n    <div class=\"row wrapflex\">\n      <button class=\"small\" data-action=\"run-now\" ${S.busy.run ? 'disabled' : ''}>\n        ${S.busy.run ? '<span class=\"spin\"></span>Running…' : 'Check lineups now'}</button>\n      <span class=\"faint small\">${st.autopilotScheduled ? 'Background checks scheduled.' : 'Background checks not scheduled yet.'}</span>\n    </div>\n  </div>`;\n}\n\nfunction skeletonCards() {\n  return [1, 2].map(() => `<div class=\"card\"><div class=\"skeleton\" style=\"width:40%\"></div>\n    <div class=\"skeleton\"></div><div class=\"skeleton\" style=\"width:80%\"></div><div class=\"skeleton\" style=\"width:60%\"></div>\n    <div class=\"muted small\" style=\"margin-top:10px\"><span class=\"spin\"></span>Pulling rosters from Sleeper and rankings from FantasyPros…</div></div>`).join('');\n}\n\nfunction rankTxt(p) {\n  if (p.posRank && p.rank) return `${esc(p.posRank)} · #${p.rank}`;\n  if (p.rank) return '#' + p.rank;\n  return '<span class=\"faint\">unranked</span>';\n}\n\nfunction playerCell(p) {\n  const tags = [];\n  if (p.isNew) tags.push('<span class=\"tag in\">IN</span>');\n  if (p.why) tags.push(`<span class=\"tag out\">${esc(p.why)}</span>`);\n  if (p.locked) tags.push('<span class=\"tag lock\" title=\"Game started: locked\">🔒</span>');\n  return `<div style=\"min-width:0\"><div class=\"pname\">${esc(p.name)}${tags.join('')}</div>\n    <div class=\"pmeta\">${esc(p.pos || '')}${p.team ? ' · ' + esc(p.team) : ''}</div></div>`;\n}\n\nfunction leagueCard(lg) {\n  const cfg = lg.settings || {};\n  return `<div class=\"card\">\n    <div class=\"row between wrapflex\">\n      <h2>${esc(lg.name)}</h2>\n    </div>\n    <div class=\"chips\">${lg.flags.map((f, i) => `<span class=\"chip ${i < 2 ? 'accent' : ''}\">${esc(f)}</span>`).join('')}</div>\n    ${lg.notes.map((n) => `<div class=\"banner info\">${esc(n)}</div>`).join('')}\n    ${lg.lineup ? lineupSection(lg) : ''}\n    ${lg.waivers ? waiverSection(lg) : ''}\n    ${settingsSection(lg, cfg)}\n  </div>`;\n}\n\nfunction lineupSection(lg) {\n  const L = lg.lineup;\n  let body;\n  if (L.error) body = `<div class=\"banner bad\">${esc(L.error)}</div>`;\n  else if (L.skipped) body = `<div class=\"banner info\">${esc(L.skipped)}</div>`;\n  else {\n    const status = L.applied ? '<div class=\"banner ok\">✓ Lineup saved to Sleeper.</div>'\n      : L.applyError ? `<div class=\"banner bad\">Couldn't save: ${esc(L.applyError)}</div>`\n      : L.changes ? `<div class=\"banner warn row between wrapflex\"><span><b>${L.changes} change${L.changes > 1 ? 's' : ''}</b>\n            recommended${L.benched.length ? ': bench ' + L.benched.map((p) => esc(p.name) + (p.why ? ' (' + esc(p.why) + ')' : '')).join(', ') : ''}</span>\n            <button class=\"small primary\" data-action=\"apply-lineup\" data-league=\"${esc(lg.id)}\" ${S.busy['l' + lg.id] ? 'disabled' : ''}>\n              ${S.busy['l' + lg.id] ? '<span class=\"spin\"></span>Saving…' : 'Apply now'}</button></div>`\n      : '<div class=\"banner ok\">✓ Lineup is already optimal.</div>';\n    body = status + L.warnings.map((w) => `<div class=\"banner bad\">⚠ ${esc(w)}</div>`).join('') +\n      `<div class=\"slots\">${L.lineup.map((p) => `<div class=\"slot ${p.isNew ? 'new' : ''} ${p.why && !p.locked ? 'bad' : ''}\">\n          <div class=\"slot-tag\">${esc(p.slot.replace('SUPER_FLEX', 'SFLEX').replace('WRRB_FLEX', 'W/R').replace('REC_FLEX', 'W/T'))}</div>\n          ${playerCell(p)}<div class=\"rank\">${rankTxt(p)}</div></div>`).join('')}</div>\n      ${L.bench.length ? `<details><summary>Bench (${L.bench.length})</summary><div class=\"slots\" style=\"margin-top:8px\">\n        ${L.bench.map((p) => `<div class=\"slot\"><div class=\"slot-tag\">BN</div>${playerCell(p)}<div class=\"rank\">${rankTxt(p)}</div></div>`).join('')}\n      </div></details>` : ''}`;\n  }\n  return `<h3>Week ${esc(L.week || '')} lineup</h3>${body}`;\n}\n\nfunction waiverSection(lg) {\n  const W = lg.waivers, cfg = lg.settings || {};\n  if (W.error) return `<h3>Waivers</h3><div class=\"banner bad\">${esc(W.error)}</div>`;\n  const claims = W.claims.map((c) => `<div class=\"claim\">\n      <div><span class=\"add\">+ ${esc(c.add.name)}</span> <span class=\"faint small\">${esc(c.add.pos)} ${esc(c.add.team || '')}\n        · ${c.kind === 'stream' ? 'this week ' : 'ROS '}${rankTxt(c.add)}</span>\n        ${c.drop ? `<div class=\"small\"><span class=\"drop\">− ${esc(c.drop.name)}</span>${c.drop.why ? `<span class=\"tag out\">${esc(c.drop.why)}</span>` : ''}\n          <span class=\"faint\">${esc(c.drop.pos)} · ${c.kind === 'stream' ? 'this week ' : 'ROS '}${rankTxt(c.drop)}</span></div>`\n          : '<div class=\"small faint\">No drop needed (open roster spot)</div>'}\n        ${c.error ? `<div class=\"small\" style=\"color:var(--bad)\">Failed: ${esc(c.error)}</div>` : ''}</div>\n      <div class=\"small\" style=\"text-align:right\">${c.bid != null ? `<b>$${c.bid}</b><br>` : ''}\n        ${c.submitted ? '<span style=\"color:var(--accent)\">✓ submitted</span>' : `<span class=\"faint\">${c.kind === 'stream' ? 'stream' : 'upgrade'}</span>`}</div>\n    </div>`).join('');\n  const when = cfg.auto_waivers ? (S.state.mode === 'auto' ? 'Autopilot will submit these the evening before waivers run.'\n                                                           : 'Turn autopilot on to submit these automatically.')\n                                : 'Auto-claims are off for this league.';\n  return `<h3>Waiver plan</h3>\n    ${W.pending ? `<div class=\"banner info\">${W.pending} claim${W.pending > 1 ? 's' : ''} already pending on Sleeper (not repeated).</div>` : ''}\n    ${W.claims.length ? claims : '<div class=\"banner ok\">No pickups clearly better than your roster right now.</div>'}\n    ${W.notes.map((n) => `<div class=\"small faint\">• ${esc(n)}</div>`).join('')}\n    ${W.claims.length ? `<div class=\"row between wrapflex\" style=\"margin-top:8px\"><span class=\"small muted\">${esc(when)}</span>\n      <button class=\"small\" data-action=\"submit-claims\" data-league=\"${esc(lg.id)}\" ${S.busy['w' + lg.id] ? 'disabled' : ''}>\n        ${S.busy['w' + lg.id] ? '<span class=\"spin\"></span>Submitting…' : 'Submit claims now'}</button></div>` : ''}\n    <div class=\"small faint\" style=\"margin-top:6px\">Based on ${esc(W.basis)}.</div>`;\n}\n\nfunction settingsSection(lg, cfg) {\n  const id = esc(lg.id);\n  const toggle = (key, label, hint) => `<div class=\"setting\"><div><div class=\"label\">${label}</div>\n      ${hint ? `<div class=\"hint\">${hint}</div>` : ''}</div>\n      <label class=\"switch sm\"><input type=\"checkbox\" data-setting=\"${key}\" data-league=\"${id}\" ${cfg[key] ? 'checked' : ''}>\n      <span class=\"slider\"></span></label></div>`;\n  const qb = lg.superflex ? `<div class=\"setting\"><div><div class=\"label\">Lean towards a 2nd QB</div>\n      <div class=\"hint\">SUPER_FLEX: a QB counts <b data-out=\"qb-${id}\">${cfg.superflex_qb_bonus}</b> ECR spots better</div></div>\n      <input type=\"range\" min=\"0\" max=\"40\" step=\"5\" value=\"${cfg.superflex_qb_bonus}\" data-setting=\"superflex_qb_bonus\"\n        data-league=\"${id}\"></div>` : '';\n  return `<details><summary>League settings</summary><div class=\"settings-grid\">\n      ${toggle('auto_lineup', 'Auto lineup', 'Autopilot sets the best lineup before games')}\n      ${toggle('auto_waivers', 'Auto waiver claims', 'Autopilot submits the waiver plan before waivers process')}\n      ${toggle('stream_k_def', 'Stream K / DEF', 'Swap kicker/defense for clearly better matchups')}\n      ${qb}\n      <div class=\"setting\"><div><div class=\"label\">Upgrade claims per week</div>\n        <div class=\"hint\">K/DEF streams come on top of these</div></div>\n        <input class=\"num\" type=\"number\" min=\"0\" max=\"5\" value=\"${cfg.max_claims}\" data-setting=\"max_claims\" data-league=\"${id}\"></div>\n      <div class=\"setting\"><div><div class=\"label\">Minimum upgrade</div><div class=\"hint\">ROS ECR spots a pickup must gain</div></div>\n        <input class=\"num\" type=\"number\" min=\"0\" max=\"200\" step=\"5\" value=\"${cfg.min_gain}\" data-setting=\"min_gain\" data-league=\"${id}\"></div>\n    </div></details>`;\n}\n\nfunction activityCard(log) {\n  const icon = { change: '✓', error: '!', warn: '!', info: '•' };\n  const items = log.slice(0, 25).map((e) => `<div class=\"entry\">\n      <div class=\"ico ${esc(e.level)}\">${icon[e.level] || '•'}</div>\n      <div><div class=\"row between\"><b style=\"font-size:14px\">${esc(e.title)}</b><span class=\"faint small\">${ago(e.ts)}</span></div>\n        ${e.league ? `<div class=\"small muted\">${esc(e.league)}</div>` : ''}\n        ${e.lines && e.lines.length ? `<pre>${esc(e.lines.join('\\n'))}</pre>` : ''}</div></div>`).join('');\n  return `<div class=\"card\"><h2>Activity</h2>\n    <div class=\"feed\" style=\"margin-top:6px\">${items || '<div class=\"muted small\">Nothing yet. Changes the autopilot makes show up here.</div>'}</div></div>`;\n}\n\n// ---- events ------------------------------------------------------------\n// For the DevTools console on sleeper.com.\nconst CONSOLE_LINE = 'copy(JSON.stringify({token: localStorage.token, user_id: localStorage.user_id}))';\n// Runs on sleeper.com: copies the session sleeper.com keeps in localStorage.\nconst BOOKMARKLET = \"javascript:(()=>{const t=localStorage.getItem('token'),u=localStorage.getItem('user_id');\" +\n  \"if(!t){alert('Log in to sleeper.com first, then tap this again.');return}\" +\n  \"const s=JSON.stringify({token:t,user_id:u});navigator.clipboard.writeText(s)\" +\n  \".then(()=>alert('Copied! Go back to Sleeper Autopilot and paste.'),()=>prompt('Copy this, then paste it into Sleeper Autopilot:',s))})()\";\n\ndocument.addEventListener('submit', async (ev) => {\n  const form = ev.target.closest('form[data-form]');\n  if (!form) return;\n  ev.preventDefault();\n  const f = Object.fromEntries(new FormData(form));\n  S.login.error = null;\n  try {\n    if (form.dataset.form === 'login') {\n      S.login.identifier = f.identifier;\n      const r = await busy('login', async () => {\n        try {\n          const b = await browserLogin(f.identifier, f.password);\n          return b.token ? api('connectWithToken', b.token, f.identifier, b.userId) : Object.assign(b, { via: 'browser' });\n        } catch (e) {\n          if (!(e instanceof Blocked)) throw e;\n          return Object.assign(await api('login', f.identifier, f.password), { via: 'server' });\n        }\n      });\n      if (r.needsCode) {\n        S.login = { step: 'code', sentTo: r.sentTo, via: r.via, identifier: f.identifier };\n        render._focused = false; render(); return;\n      }\n      S.state = r;\n    } else if (form.dataset.form === 'code') {\n      const L = S.login;\n      S.state = await busy('login', async () => {\n        if (L.via === 'server') return api('verifyCode', f.code);\n        const b = await browserLogin(L.identifier, String(f.code).trim());\n        return api('connectWithToken', b.token, L.identifier, b.userId);\n      });\n    } else if (form.dataset.form === 'token') {\n      S.state = await busy('login', () => api('connectWithToken', f.token, f.username || null, null));\n    }\n    S.login = freshLogin();\n    render();\n    toast('Connected to Sleeper');\n    loadDashboard();\n  } catch (e) {\n    S.login.error = e.message; render._focused = false; render();\n  }\n});\n\ndocument.addEventListener('click', async (ev) => {\n  const el = ev.target.closest('[data-action]');\n  if (!el || el.matches('input')) return;\n  const a = el.dataset.action, id = el.dataset.league;\n  if (a === 'reload') { ev.preventDefault(); loadDashboard(); }\n  if (a === 'install-update') installUpdate();\n  if (a === 'remove-update') {\n    S.state = await api('removeUpdate');\n    S.update = {}; render(); toast('Update removed. Reload the app.');\n  }\n  if (a === 'login-token') {\n    S.login = { step: 'token', desktop: matchMedia('(pointer: fine)').matches };\n    render._focused = false; render();\n  }\n  if (a === 'copy-helper') {\n    const done = () => toast('Helper copied. Now make the bookmark.');\n    navigator.clipboard.writeText(BOOKMARKLET).then(done, () => {\n      const t = $('#helper'); t.select();\n      toast(document.execCommand('copy') ? 'Helper copied. Now make the bookmark.' : 'Long-press the text and copy it.');\n    });\n  }\n  if (a === 'login-restart') { S.login = { step: 'password' }; render._focused = false; render(); }\n  if (a === 'logout') {\n    if (!confirm('Disconnect from Sleeper? The autopilot stops until you log in again.')) return;\n    S.state = await api('logout'); S.dash = null; render();\n  }\n  if (a === 'run-now') {\n    S.state = await busy('run', () => api('runNow'));\n    toast(S.state.lastTick ? S.state.lastTick.msg : 'Done');\n    loadDashboard();\n  }\n  if (a === 'apply-lineup') {\n    const res = await busy('l' + id, () => api('applyLineup', id));\n    replaceLeague(res);\n    S.state = await api('getState'); render();\n    toast(res.lineup && res.lineup.applied ? 'Lineup saved to Sleeper' : 'Nothing saved');\n  }\n  if (a === 'submit-claims') {\n    if (!confirm('Submit these waiver claims to Sleeper now?')) return;\n    const res = await busy('w' + id, () => api('submitClaims', id));\n    replaceLeague(res);\n    S.state = await api('getState'); render();\n    toast('Claims sent');\n  }\n});\n\ndocument.addEventListener('change', async (ev) => {\n  const el = ev.target;\n  if (el.dataset.action === 'mode') {\n    const mode = el.checked ? 'auto' : 'suggest';\n    if (mode === 'auto' && !confirm('Turn autopilot on? It will change lineups on Sleeper by itself '\n        + '(and submit claims in leagues where you enabled auto claims).')) { el.checked = false; return; }\n    S.state = await busy('mode', () => api('setMode', mode));\n    render();\n    toast(mode === 'auto' ? 'Autopilot on' : 'Autopilot paused');\n    return;\n  }\n  if (el.dataset.setting) {\n    const key = el.dataset.setting, id = el.dataset.league;\n    const val = el.type === 'checkbox' ? el.checked : Number(el.value);\n    const cfg = await api('saveLeagueSettings', id, { [key]: val });\n    const lg = S.dash && S.dash.leagues.find((l) => l.id === id);\n    if (lg) lg.settings = cfg;\n    toast('Saved');\n    if (['superflex_qb_bonus', 'stream_k_def', 'max_claims', 'min_gain'].includes(key)) loadDashboard();\n  }\n});\n\ndocument.addEventListener('input', (ev) => {\n  const el = ev.target;\n  if (el.dataset.setting === 'superflex_qb_bonus') {\n    const out = document.querySelector(`[data-out=\"qb-${el.dataset.league}\"]`);\n    if (out) out.textContent = el.value;\n  }\n});\n\nboot();\n</script>\n</body>\n</html>\n";
var BUILD_INFO = {"id":"33a24a7ecd","version":9,"title":"Lineups actually save","notes":[{"title":"Lineups actually save","items":["\"Apply now\" (and the autopilot) now save the lineup for the right week: Sleeper keeps one lineup per week, and the old call only covered the league's current week, which lags a day behind. Sleeper quietly ignored it.","After saving, the app checks what Sleeper stored and shows an error if it didn't take.","No more pointless slot swaps (e.g. two RBs trading the RB and flex spots)."]},{"title":"Smarter waiver claims","items":["Won't drop a top-12 kicker or defense just to stream one week (e.g. during his bye).","Won't stack extra QBs/TEs beyond useful depth at the cost of other positions; a 4th QB can only replace a QB.","Injured (Out/IR) players no longer count toward position minimums, so it keeps enough healthy starters."]},{"title":"Fix garbled \"On a computer\" steps","items":["Google cut off everything after \"//\" in the sleeper.com links, which scrambled the connect steps (and would have broken your profile picture). Links are now written so nothing gets cut."]},{"title":"Updates without Google's script API","items":["\"Install update\" now stores the new version inside the app, so it no longer needs Google's Apps Script API, a Cloud project or extra permissions.","If an installed update ever fails to load, the app runs the version you pasted and offers to remove the update."]},{"title":"Connect via sleeper.com first","items":["Fixes \"Invalid argument …/user/\\\"…\\\"\": the user id copied from sleeper.com comes wrapped in quotes.","The app now opens on \"Connect via sleeper.com\", since Sleeper blocks password logins from other sites with a captcha.","Checks which Google permissions you actually granted (Google's screen has a checkbox for each) and shows an \"Approve in Google\" button for any that are missing."]},{"title":"Easier \"connect via sleeper.com\"","items":["When Sleeper asks for a captcha, a \"Connect via sleeper.com\" button appears right under the message.","Clearer phone steps, and a copy-paste console line for computers.","If an update can't install, the message links straight to your script editor and quotes Google's reason."]},{"title":"Install updates from the app","items":["New \"Install update\" button: future versions install from GitHub with one tap, no more pasting.","The app shows which version it is running."]},{"title":"Log in from your browser","items":["The login goes straight from your browser to Sleeper, which fixes \"unable to confirm you're human\".","Clearer message when Sleeper wants a captcha, plus a phone-friendly sleeper.com fallback."]}]};
loadInstalledUpdate_();
