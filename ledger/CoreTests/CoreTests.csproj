<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Match Unity 6's compiler level so nothing Unity can't compile sneaks in -->
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Ledger.CoreTests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/Scripts/Core/**/*.cs" />
    <!-- Engine-free content files, tested as SHIPPED rather than as a copy of
         themselves that can drift away from what the game actually loads. -->
    <Compile Include="../Assets/Scripts/Game/AccessSetup.cs" />
    <Compile Include="../Assets/Scripts/Game/EconomySetup.cs" />
    <Compile Include="../Assets/Scripts/Game/OperationSetup.cs" />
  </ItemGroup>
</Project>
